{
  "properties": {
    "activities": [
      {
        "name": "Set start month",
        "description": "Empty startMonth = rolling window: the monthCount full months before the current month.",
        "type": "SetVariable",
        "dependsOn": [],
        "policy": {
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "variableName": "effectiveStartMonth",
          "value": {
            "value": "@if(empty(pipeline().parameters.startMonth), formatDateTime(subtractFromTime(startOfMonth(utcNow()), pipeline().parameters.monthCount, 'Month'), 'yyyy-MM'), pipeline().parameters.startMonth)",
            "type": "Expression"
          }
        }
      },
      {
        "name": "Bronze ingestion",
        "type": "ExecutePipeline",
        "dependsOn": [
          {
            "activity": "Set start month",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "pipeline": {
            "referenceName": "01dba2df-9e86-4f17-a50a-cbe42d39371c",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true,
          "parameters": {
            "startMonth": {
              "value": "@variables('effectiveStartMonth')",
              "type": "Expression"
            },
            "monthCount": {
              "value": "@pipeline().parameters.monthCount",
              "type": "Expression"
            }
          }
        }
      },
      {
        "name": "Silver staging",
        "type": "TridentNotebook",
        "dependsOn": [
          {
            "activity": "Bronze ingestion",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "dabbb942-3114-40b2-b026-8e5b19ec9c83",
          "workspaceId": "00000000-0000-0000-0000-000000000000",
          "parameters": {
            "start_month": {
              "value": {
                "value": "@variables('effectiveStartMonth')",
                "type": "Expression"
              },
              "type": "string"
            },
            "month_count": {
              "value": {
                "value": "@pipeline().parameters.monthCount",
                "type": "Expression"
              },
              "type": "int"
            }
          }
        }
      }
    ],
    "parameters": {
      "startMonth": {
        "type": "string",
        "defaultValue": ""
      },
      "monthCount": {
        "type": "int",
        "defaultValue": 3
      }
    },
    "variables": {
      "effectiveStartMonth": {
        "type": "String"
      }
    }
  }
}
